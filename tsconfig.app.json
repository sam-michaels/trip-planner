{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],

  /*
   * TEMPORARY. Test files import `vitest`, which isn't installed yet —
   * without this exclusion `tsc -b` fails on an unresolvable module and
   * the whole build goes red.
   *
   * Delete this line the moment vitest lands. It is load-bearing in the
   * wrong direction: while it's here, test files are typechecked by no
   * project at all (vitest does not typecheck by default either — it
   * strips types with esbuild), so a test referencing a function that
   * no longer exists stays green until someone runs it.
   */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
